#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.capSpecs/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
pltfrmDevelBecome-cbs.pcs
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed, of type induct (no units)
i:  Induct      --- /Non-Service Component/ --- the developer platform: git anon to auth, pip PyPI to editable
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle: pltfrmDevelBecome-sbom.pcs (no packages: the packages of rawBisos-sbom.pcs need dev-bisos3 and
the clones first, so they are a step of the assemble) and pltfrmDevelBecome-assemble.cs (the steps of
capSpecs WorkPlan 2.3 to 2.7; fullCheck is read-only). Precondition, only checked: the ssh Host alias of
pltfrmDevelCreds. The slow, idempotent build; the fast switch is pltfrmDevelUnBecome.
#+end_org """


from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="induct",  # not systemd: cbs_materialize runs the sbom and the assemble only
    loader=None,
    sbom="pltfrmDevelBecome-sbom.pcs",
    assemble="pltfrmDevelBecome-assemble.cs",
    materialize=None,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
