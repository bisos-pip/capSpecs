#!/usr/bin/env python

""" #+begin_org
* Panel::  [[file:./py3/panels/bisos.capSpecs/_nodeBase_/fullUsagePanel-en.org]]
* Overview and Relevant Pointers
emacs31SrcBuild-cbs.pcs   (the CBM leaf emacsSrcBuild reaches it through the symlink emacsSrcBuild-cbs.pcs)
cbs: Capability Bundle Specification  -- Based on a cba-sysd.cs seed, of type induct (no units)
i:  Induct      --- /Non-Service Component/ --- Emacs 31 built from source (tag emacs-31.1), the default emacs
n:  No Data    -- Materialization is purely based on Realm-BPO
p:  Platform    -- Materialization is based on Platform-BPO (Site-BPO is not used)

The bundle: emacs31SrcBuild-sbom.pcs (no packages: the build dependencies are kept by
/bisos/blee/bin/lcaEmacsSrcBinsPrep.sh, per Debian generation) and emacs31SrcBuild-assemble.cs (that script's
steps, one by one; fullCheck is read-only). Precondition, only checked: deb-src in the apt sources.
capSpecs WorkPlan Stage 5.
#+end_org """


from bisos.capability import cba_sysd_seed
from bisos.capability import cba_seed

cba_seed.setup(
    seedType="induct",  # not systemd: cbs_materialize runs the sbom and the assemble only
    loader=None,
    sbom="emacs31SrcBuild-sbom.pcs",
    assemble="emacs31SrcBuild-assemble.cs",
    materialize=None,
)

cba_sysd_seed.plantWithWhich("cba-sysd.cs")
